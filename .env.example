# Copy to .env.local for local development, and add the same values in Vercel → Project → Settings → Environment Variables.
# Leave NEXT_PUBLIC_SANITY_PROJECT_ID empty to run on the sample content in src/content/seed.json.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-11-01

# Shared secret for the Sanity → Vercel publish webhook (any long random string; same value in Sanity's webhook settings)
SANITY_REVALIDATE_SECRET=

# Public URL of the site, used for social sharing previews (e.g. https://dialoguers.com)
NEXT_PUBLIC_SITE_URL=
